[sim.sh] slot 2: bash -c 
W=work/audit/monclaim
rm -rf $W/obj_r13 $W/obj_mc42 $W/obj_fix42 $W/obj_rf42
verilator --binary --timing -j 2 -Irtl -Wno-fatal -DREAL --top-module tb_mc --Mdir $W/obj_r13 -o tb_mc $(cat work/RTL.list) tb/site_net.v $W/tb_mc.v > $W/vl_r13.log 2>&1; echo b1=$?
timeout 1200 $W/obj_r13/tb_mc +sc=1 > $W/run_real13_sc1.log 2>&1; echo r1=$?
verilator --binary --timing -j 2 -Irtl -Wno-fatal --top-module tb_mc2 --Mdir $W/obj_mc2 -o tb_mc2 $(cat work/RTL.list) tb/site_net.v $W/tb_mc2.v > $W/vl_mc2.log 2>&1; echo b2=$?
timeout 2400 $W/obj_mc2/tb_mc2 > $W/run_mc2.log 2>&1; echo r2=$?

b1=0
r1=0
b2=0
r2=0
