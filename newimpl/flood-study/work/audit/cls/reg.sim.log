[sim.sh] slot 1: bash -c W=work/audit/cls; verilator --binary --timing -j 2 -Irtl -Wno-fatal +define+SCALE8 +define+POOL8 --top-module tb_cls --Mdir $W/obj_s8 -o tb_cls $(cat work/RTL.list) tb/site_net.v $W/tb_cls2.v > $W/vl_s8.log 2>&1 && timeout 1800 $W/obj_s8/tb_cls +sc=1 +K=8 > $W/run_s8_sc1K8.log 2>&1; echo rc=$? >> $W/run_s8_sc1K8.log; rm -rf $W/obj_s8; for b in net chain lfull; do verilator --binary --timing -j 2 -Irtl -Wno-fatal --top-module tb_$b --Mdir $W/obj_reg_$b -o tb_$b $(cat $W/RTL_fix.list) tb/site_net.v tb/tb_$b.v > $W/vl_reg_$b.log 2>&1 || { echo BUILDFAIL > $W/reg_fix_$b.log; continue; }; s=$(date +%s); timeout 5400 $W/obj_reg_$b/tb_$b > $W/reg_fix_$b.log 2>&1; echo rc=$? secs=$(( $(date +%s) - s )) >> $W/reg_fix_$b.log; rm -rf $W/obj_reg_$b; done; echo ALLDONE > $W/reg.done
