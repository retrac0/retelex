[sim.sh] slot 2: bash -c 
cd /home/joel/telco/newimpl/build/flood; D=work/verify/C16-marker-reread; W=work/audit/monclaim
verilator --binary --timing -j 2 -I$D/rtl_fix -Irtl -Wno-fatal --top-module tb_c16 --Mdir $D/obj_f8 -o tb_c16 $(cat $D/RTL_fix.list) tb/site_net.v $D/tb_c16.v > $D/vl_f8.log 2>&1; echo b=$?
timeout 1500 $D/obj_f8/tb_c16 +case=1 > $D/run_f8_c1.log 2>&1; echo r1=$?
timeout 1500 $D/obj_f8/tb_c16 +case=2 > $D/run_f8_c2.log 2>&1; echo r2=$?
rm -rf $D/obj_f8
verilator --binary --timing -j 2 -I$D/rtl_fix -Irtl -Wno-fatal --top-module tb_mc --Mdir $D/obj_fmc -o tb_mc $(cat $D/RTL_fix.list) tb/site_net.v $W/tb_mc.v > $D/vl_fmc.log 2>&1; echo bm=$?
timeout 1200 $D/obj_fmc/tb_mc +sc=2 > $D/run_fmc_sc2.log 2>&1; echo rm=$?
rm -rf $D/obj_fmc
verilator --binary --timing -j 2 -I$D/rtl_fix -Irtl -Wno-fatal -DREAL --top-module tb_c16 --Mdir $D/obj_fr -o tb_c16 $(cat $D/RTL_fix.list) tb/site_net.v $D/tb_c16.v > $D/vl_fr.log 2>&1; echo br=$?
timeout 2400 $D/obj_fr/tb_c16 +case=1 > $D/run_fr_c1.log 2>&1; echo rr=$?
rm -rf $D/obj_fr

b=0
r1=0
r2=0
bm=0
rm=0
br=0
rr=0
