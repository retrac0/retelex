# each run below: python3 falstad_cvsd.py <circuit> -o <name>.txt <options>, then
#                 node falstad/sim.mjs <name>.txt <seconds> <name>.json
# engine_nominal                 engine
# engine_minus20                 engine --level-db -20
# engine_minus20_8steps          engine --level-db -20 --steps 8
# dm_noise_only, dm_impulse_only dmlink --line-level 0 --noise 1    |  --line-level 0 --impulse 1 --impulse-hz 2000
# dm_clean                       dmlink
# dm_sd04, dm_sd07, dm_sd10      dmlink --noise 0.61 | 1.07 | 1.53   (the documents sd 0.4, 0.7, 1.0)
# dm_noise2V                     dmlink --noise 2.0
# dm_impulses                    dmlink --impulse 3 --impulse-hz 517
# dm_quarter_level               dmlink --line-level 0.25 --noise 0.153   (attenuated 0.25x at sd 0.10)
# dm_dead_pair                   dmlink --line-level 0 --noise 0.153
# link_nominal, link_minus20     link | link --level-db -20
# link_sd04, link_sd07           link --noise 0.61 | link --noise 1.07
# link_impulses                  link --impulse 3 --impulse-hz 517
# the noise source is not seeded: a rerun moves the noisy rows

